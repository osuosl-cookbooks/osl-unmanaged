#!/bin/bash
set -ex
<% if %w(rhel).include?(node['platform_family']) -%>
<% if node['platform_version'].to_i >= 8 -%>
# Delay automatic updates so they don't hold the package lock right after first boot
systemctl enable dnf-automatic-install.timer
systemd-run --on-active=30min systemctl start dnf-automatic-install.timer
<% else -%>
systemctl enable --now yum-cron.service
<% end -%>
<% elsif %w(fedora).include?(node['platform_family']) -%>
# Delay automatic updates so they don't hold the package lock right after first boot
systemctl enable dnf-automatic.timer
systemd-run --on-active=30min systemctl start dnf-automatic.timer
<% elsif node['platform_family'] == 'debian' -%>
systemctl unmask apt-daily-upgrade.service apt-daily.service
systemctl enable --now unattended-upgrades.service
# Delay automatic updates so they don't hold the apt lock right after first boot
systemctl enable apt-daily.timer apt-daily-upgrade.timer
systemd-run --on-active=30min systemctl start apt-daily.timer apt-daily-upgrade.timer
<% end -%>
systemctl disable osuosl-firstboot
rm -rf /etc/systemd/system/osuosl-firstboot.service
rm -rf /usr/local/libexec/firstboot.sh
systemctl daemon-reload
